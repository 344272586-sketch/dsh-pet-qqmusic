{
  "name": "dsh-pet-qqmusic",
  "version": "1.3.2",
  "description": "鲸歌：让 dsh-pet 跟着 QQ 音乐 / 网易云音乐逐行显示歌词。QQ 音乐走 Windows SMTC，网易云读本地 cloudmusic.elog（无需插件、支持 seek），延迟可调、翻译、桌面悬浮模式不切动画",
  "icon": "assets/logo.svg",
  "author": "dsh-pet-qqmusic contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/344272586-sketch/dsh-pet-qqmusic.git"
  },
  "bugs": {
    "url": "https://github.com/344272586-sketch/dsh-pet-qqmusic/issues"
  },
  "homepage": "https://github.com/344272586-sketch/dsh-pet-qqmusic#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-pet",
    "qqmusic",
    "netease-cloud-music",
    "lyrics",
    "desktop-pet"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "patch-dsh-pet": "node scripts/patch-dsh-pet-quiet-lyrics.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1"
  },
  "license": "MIT"
}
